# Template: install.sh installs it as /etc/sudoers.d/pi-dash (after checking it with visudo).
# The only root commands pi-dash runs: restarting/shutting down the Pi and controlling system units.
@USER@ ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/systemctl start *, /usr/bin/systemctl stop *, /usr/bin/systemctl restart *
